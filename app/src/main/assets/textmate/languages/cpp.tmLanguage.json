{
  "scopeName": "source.cpp",
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b"
    },
    {
      "name": "keyword.control.import",
      "match": "^\\s*#\\s*(?:include|define|ifdef|ifndef|endif|pragma)\\b.*$"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:if|else|for|while|do|switch|case|break|continue|return|try|catch|throw|class|struct|enum|namespace|template|typename|using|public|private|protected|virtual|override|const|static|inline|new|delete|include)\\b"
    },
    {
      "name": "constant.language",
      "match": "\\b(?:true|false|nullptr|this)\\b"
    },
    {
      "name": "storage.type",
      "match": "\\b(?:void|int|long|short|char|float|double|bool|auto|size_t|string)\\b"
    },
    {
      "name": "entity.name.type.class",
      "match": "\\b(?:class|struct|enum)\\s+([A-Za-z_][\\w]*)",
      "captures": {
        "1": {
          "name": "entity.name.class"
        }
      }
    }
  ]
}