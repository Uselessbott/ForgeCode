{
  "scopeName": "source.js",
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.template",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b"
    },
    {
      "name": "keyword.control.import",
      "match": "\\b(?:import|from|export|as|default)\\b"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:if|else|for|while|do|switch|case|break|continue|return|try|catch|finally|throw|new|await|async|yield|class|extends|function|const|let|var)\\b"
    },
    {
      "name": "constant.language",
      "match": "\\b(?:true|false|null|undefined|this|super)\\b"
    },
    {
      "name": "entity.name.type.class",
      "match": "\\bclass\\s+([A-Za-z_$][\\w$]*)",
      "captures": {
        "1": {
          "name": "entity.name.class"
        }
      }
    },
    {
      "name": "entity.name.function",
      "match": "\\bfunction\\s+([A-Za-z_$][\\w$]*)",
      "captures": {
        "1": {
          "name": "entity.name.function"
        }
      }
    }
  ]
}