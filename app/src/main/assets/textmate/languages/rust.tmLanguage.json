{
  "scopeName": "source.rust",
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b"
    },
    {
      "name": "keyword.control.import",
      "match": "\\b(?:use|mod|crate)\\b"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:fn|let|mut|pub|struct|enum|impl|trait|use|mod|crate|self|super|if|else|match|while|for|loop|return|break|continue|async|await|move|ref|where|type|const|static)\\b"
    },
    {
      "name": "constant.language",
      "match": "\\b(?:true|false|Some|None|Ok|Err)\\b"
    },
    {
      "name": "storage.type",
      "match": "\\b(?:i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|char|str|String)\\b"
    },
    {
      "name": "entity.name.type.class",
      "match": "\\b(?:struct|enum|trait)\\s+([A-Za-z_][\\w]*)",
      "captures": {
        "1": {
          "name": "entity.name.class"
        }
      }
    },
    {
      "name": "entity.name.function",
      "match": "\\bfn\\s+([A-Za-z_][\\w]*)",
      "captures": {
        "1": {
          "name": "entity.name.function"
        }
      }
    }
  ]
}