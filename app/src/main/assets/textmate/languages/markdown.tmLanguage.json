{
  "scopeName": "text.markdown",
  "patterns": [
    {
      "name": "markup.heading",
      "match": "^#{1,6}\\s.*$"
    },
    {
      "name": "markup.bold",
      "match": "\\*\\*[^*]+\\*\\*"
    },
    {
      "name": "markup.italic",
      "match": "\\*[^*\\n]+\\*"
    },
    {
      "name": "string.other.link",
      "match": "\\[[^\\]]+\\]\\([^\\)]+\\)"
    },
    {
      "name": "comment.quote",
      "match": "^>\\s.*$"
    },
    {
      "name": "markup.inline.raw",
      "match": "`[^`]+`"
    }
  ]
}