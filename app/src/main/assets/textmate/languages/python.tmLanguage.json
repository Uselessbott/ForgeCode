{
  "scopeName": "source.python",
  "patterns": [
    {
      "name": "comment.line",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b"
    },
    {
      "name": "keyword.control.import",
      "match": "\\b(?:import|from|as)\\b"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:if|elif|else|for|while|try|except|finally|with|return|raise|break|continue|pass|yield|match|case|assert|def|class|lambda|async|await)\\b"
    },
    {
      "name": "storage.type",
      "match": "\\b(?:int|str|float|bool|list|dict|set|tuple|None|True|False)\\b"
    },
    {
      "name": "entity.name.type.class",
      "match": "\\bclass\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "entity.name.class"
        }
      }
    },
    {
      "name": "entity.name.function",
      "match": "\\bdef\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "entity.name.function"
        }
      }
    }
  ]
}