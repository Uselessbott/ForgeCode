{
  "scopeName": "source.java",
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b"
    },
    {
      "name": "keyword.control.import",
      "match": "\\b(?:import|package)\\b"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:if|else|for|while|do|switch|case|break|continue|return|try|catch|finally|throw|new|class|interface|enum|extends|implements|public|private|protected|static|final|abstract|synchronized|volatile|import|package|instanceof)\\b"
    },
    {
      "name": "constant.language",
      "match": "\\b(?:true|false|null|this|super)\\b"
    },
    {
      "name": "storage.type",
      "match": "\\b(?:void|int|long|short|byte|float|double|boolean|char|var)\\b"
    },
    {
      "name": "entity.name.type.class",
      "match": "\\b(?:class|interface|enum)\\s+([A-Za-z_][\\w]*)",
      "captures": {
        "1": {
          "name": "entity.name.class"
        }
      }
    }
  ]
}